<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Создание GIF-анимации</title>
    <style>
        body {
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        #drop-zone {
            border: 2px dashed #ccc;
            border-radius: 5px;
            width: 90%;
            max-width: 500px;
            height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            cursor: pointer;
        }
        #drop-zone.dragover {
            border-color: #007bff;
        }
        #file-list {
            margin-top: 20px;
            width: 90%;
            max-width: 500px;
        }
        #preview-container {
            margin-top: 20px;
            text-align: center;
        }
        #gif-preview {
            max-width: 100%;
            border: 1px solid #ccc;
            margin-top: 10px;
        }
        button {
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
        }
        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <h1>Создание GIF-анимации из изображений</h1>
    <div id="drop-zone">
        <p>Перетащите сюда PNG или JPG файлы</p>
        <input type="file" id="file-input" multiple accept="image/png, image/jpeg" style="display: none;">
    </div>
    <div id="file-list">
        <h3>Выбранные файлы:</h3>
        <ul id="selected-files"></ul>
    </div>
    <button id="create-gif-btn">Создать GIF</button>
    <div id="preview-container">
        <h3>Предпросмотр GIF:</h3>
        <img id="gif-preview" src="#" alt="Предпросмотр GIF" style="display: none;">
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gifjs/0.2.0/gif.min.js"></script>

    <script>
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');
        const selectedFilesList = document.getElementById('selected-files');
        const createGifBtn = document.getElementById('create-gif-btn');
        const gifPreview = document.getElementById('gif-preview');

        let files = []; // Массив для хранения выбранных файлов

        // Обработка перетаскивания файлов
        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('dragover');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('dragover');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            const droppedFiles = Array.from(e.dataTransfer.files);
            processFiles(droppedFiles);
        });

        // Обработка выбора файлов через кнопку
        dropZone.addEventListener('click', () => {
            fileInput.click();
        });

        fileInput.addEventListener('change', (e) => {
            const selectedFiles = Array.from(e.target.files);
            processFiles(selectedFiles);
        });

        function processFiles(fileList) {
            fileList.forEach(file => {
                if (file.type === 'image/png' || file.type === 'image/jpeg') {
                    files.push(file);
                    const listItem = document.createElement('li');
                    listItem.textContent = file.name;
                    selectedFilesList.appendChild(listItem);
                } else {
                    alert(`Файл "${file.name}" не является PNG или JPG и будет проигнорирован.`);
                }
            });
            // Сортировка файлов по имени для корректного порядка анимации
            files.sort((a, b) => a.name.localeCompare(b.name));
        }

        // Создание GIF-анимации
        createGifBtn.addEventListener('click', () => {
            if (files.length === 0) {
                alert('Пожалуйста, выберите или перетащите файлы для создания GIF.');
                return;
            }

            const gif = new GIF({
                workers: 2, // Количество рабочих потоков для кодирования
                quality: 10 // Качество GIF (0-10)
            });

            // Добавляем каждый файл в GIF
            files.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = (event) => {
                    const img = new Image();
                    img.onload = () => {
                        gif.addFrame(img, { delay: 200 }); // Задержка между кадрами в миллисекундах
                        if (index === files.length - 1) {
                            gif.render(); // Отрисовка GIF после добавления всех кадров
                        }
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            });

            // Обработка завершения отрисовки GIF
            gif.ononRender = (blob) => {
                const url = URL.createObjectURL(blob);
                gifPreview.src = url;
                gifPreview.style.display = 'block';
                const downloadLink = document.createElement('a');
                downloadLink.href = url;
                downloadLink.download = 'animation.gif';
                downloadLink.textContent = 'Скачать GIF';
                downloadLink.style.display = 'block';
                downloadLink.style.marginTop = '10px';
                // Удаляем предыдущую ссылку, если она есть
                const existingLink = document.querySelector('a[download="animation.gif"]');
                if(existingLink) {
                    existingLink.remove();
                }
                previewContainer.appendChild(downloadLink);
            };
        });
    </script>
</body>
</html>
